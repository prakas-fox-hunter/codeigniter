CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8000/'
app.indexPage = ''
# Demo only: exposes reset links in API responses. Disable outside localhost.
app.demo = true
database.default.hostname = 127.0.0.1
database.default.database = skybook
database.default.username = skybook
database.default.password = replace-with-random-database-password
database.default.DBDriver = MySQLi
database.default.port = 3307
JWT_SECRET = replace-with-at-least-32-random-characters
MARIADB_DATABASE = skybook
MARIADB_USER = skybook
MARIADB_PASSWORD = replace-with-random-database-password
MARIADB_ROOT_PASSWORD = replace-with-another-random-password
